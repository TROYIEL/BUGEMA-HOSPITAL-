APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=hospital
APPWRITE_PUBLIC_BUCKET_ID=hospital_public
APPWRITE_PRIVATE_BUCKET_ID=hospital_private
SITE_URL=http://localhost:3000
