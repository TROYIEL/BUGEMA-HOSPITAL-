NEXT_PUBLIC_APPWRITE_ENDPOINT=https://YOUR_REGION.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_PUBLIC_BUCKET_ID=hospital_public
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Used only by scripts/bootstrap-admin.mjs, not by the application.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Hospital administrator
